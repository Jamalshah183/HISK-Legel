rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'jamalshah183@gmail.com';
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

