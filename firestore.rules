rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'jamalshah183@gmail.com' ||
        request.auth.token.email.lower() == 'adv.kayani@gmail.com' ||
        request.auth.token.email.lower() == 'adv.kiyani@gmail.com' ||
        request.auth.token.email.lower() == 'aamer222@gmail.com'
      );
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

